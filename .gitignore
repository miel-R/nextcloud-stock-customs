.DS_Store
.idea/
*.iml

/php/data/*
/php/session/*
!/php/data/.gitkeep
!/php/session/.gitkeep
/php/vendor

/manual-install/*.conf
!/manual-install/sample.conf
/manual-install/docker-compose.yml
/manual-install/compose.yaml
/manual-install/.env

# SSL certificates and private keys - never commit to git!
*.crt
*.key
*.pem

# local env - never commit
.env
.env.db

# n8n switch: compose now uses a Compose named volume (n8n_data), NOT a bind
# mount, so no host dir needed. Keep ignoring any leftover ./n8n_data host dir
# (from earlier bind-mount installs) so it is never committed.
/n8n_data/


# local agent sessions
session-ses_*.md


/.env
/.env.db

session*
.history/
