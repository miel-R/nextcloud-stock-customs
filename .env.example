# ============================================================================
# Nextcloud stack - environment template
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored):
#     cp .env.example .env
# ============================================================================

# --- Database & admin (used only on first boot) ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
# n8n database + role (both default to "n8n" - uncomment only when overriding,
# and only when using n8n, see N8N.md). The n8n role reuses POSTGRES_PASSWORD.
# N8N_DB_NAME=n8n
# N8N_DB_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_long_random
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_long_random

# --- n8n install toggle ---
# COMPOSE_PROFILES is the operative switch: "n8n" = run n8n, empty = don't.
# N8N_INSTALL is a human-readable marker you keep in sync (true/false).
# Compose reads COMPOSE_PROFILES only; the Nextcloud app/DB stacks are
# unaffected by it either way.
N8N_INSTALL=false
COMPOSE_PROFILES=          # "n8n" when installing n8n; empty when not

# --- n8n public exposure (optional - only when proxying n8n through Caddy on
# its own hostname, see N8N.md "Self-hosting both on one Funnel domain") ---
# Leave blank/empty to keep n8n loopback-only / internal.
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# N8N_PORT=5678

# --- Public domain (no scheme, no port, NO trailing slash) ---
# REPLACE in all three places below: NC_DOMAIN, OVERWRITECLIURL,
# NEXTCLOUD_TRUSTED_DOMAINS. Example (Tailscale MagicDNS): k1234-abcdef.ts.net
NC_DOMAIN=nextcloud.example.com

# --- Nextcloud URL settings ---
# HTTP on :80 behind Tailscale Funnel, or HTTPS when TLS is terminated
# by an external reverse proxy / LoadBalancer.
OVERWRITECLIURL=https://nextcloud.example.com
OVERWRITEPROTOCOL=https

# Space-separated list of trusted domains. Put your real domain here as the
# last entry (the image regenerates config.php's trusted_domains from this).
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 nextcloud nextcloud.example.com

# --- Docker internal subnet (for trusted proxies) ---
# Get the real value from `docker network inspect nt_n8n_network`.
TRUSTED_PROXIES=172.16.0.0/12

# --- Talk secrets (only needed if the signaling / turn services are used) ---
# Generate with: openssl rand -base64 32   (repeat for each secret)
TURN_SECRET=CHANGE_ME_base64
SIGNALING_SECRET=CHANGE_ME_base64
INTERNAL_SECRET=CHANGE_ME_base64
# Signaling session keys (random hex):
#   BLOCK_KEY: openssl rand -hex 16    (16 bytes)
#   HASH_KEY:  openssl rand -hex 32    (32 bytes)
BLOCK_KEY=CHANGE_ME_hex32
HASH_KEY=CHANGE_ME_hex64
# Optional: skip signaling-backend certificate validation (only for
# internal-only HTTP/TLS-less setups, see readme.md -> Talk).
# SKIP_VERIFY=false
# If the `turn` service auto-detects the wrong relay address, add
# `ETURNAL_RELAY_IPV4_ADDR: ${TURN_RELAY_IP:-}` to its environment in
# compose.yaml and set this to this host's public IPv4 address:
# TURN_RELAY_IP=

# ============================================================================
# SIZING (memory / CPU / replicas) - env-driven, NO hardcoded values in the
# compose files. Pick ONE preset below and copy it into .env, then restart:
#     docker compose -f compose.db.yaml up -d
#     docker compose up -d --remove-orphans
# See SCALING.md for the full explanation and the scale-on-demand rules.
# ============================================================================

# --- Preset A: SMALL host (>= 8 GB RAM, Talk required) - the current default
APP_REPLICAS=1                  # minimum is 1; do NOT raise on <= 16 GB host
APP_MEM_LIMIT=3G                # FPM pool auto-scales from this (150 MB/child)
APP_MEM_RES=1G
APP_CPUS_LIMIT=2
APP_CPUS_RES=1
# PHP-FPM auto-scaling (AIO-style). Leave empty to derive pm.max_children from
# APP_MEM_LIMIT (3G -> ~20 children). Override only if you calibrate per child:
APP_FPM_MAX_CHILDREN=
APP_FPM_START_SERVERS=
APP_FPM_MIN_SPARE=
APP_FPM_MAX_SPARE=
NGINX_MEM_LIMIT=256M
NGINX_MEM_RES=128M
NGINX_CPUS_LIMIT=1
NGINX_CPUS_RES=0.5
CRON_MEM_LIMIT=512M
CRON_MEM_RES=256M
CRON_CPUS_LIMIT=1
CRON_CPUS_RES=0.5
SIGNALING_MEM_LIMIT=1G          # Talk - keep it healthy
SIGNALING_MEM_RES=512M
SIGNALING_CPUS_LIMIT=1
SIGNALING_CPUS_RES=0.5
TURN_MEM_LIMIT=512M             # Talk - keep it healthy
TURN_MEM_RES=256M
TURN_CPUS_LIMIT=1
TURN_CPUS_RES=0.5
CADDY_MEM_LIMIT=256M
CADDY_MEM_RES=128M
CADDY_CPUS_LIMIT=1
CADDY_CPUS_RES=0.5
UPLOAD_MAX_SIZE=2G   # keep in sync with php-custom.ini (PHP) + nginx client_max_body_size
# TURN relay UDP port range, published ONLY when using the optional override:
#     docker compose -f compose.yaml -f compose.turn.yaml up -d
# Keep it small (default 48000-48200). On Docker Desktop set TURN_RELAY_PORTS=
# (empty) to skip relay port publication locally - the main compose.yaml already
# publishes 3478, which covers signaling-only setups.
# TURN_RELAY_PORTS=48000-48200
# DB / Redis (stateful, singleton)
DB_MEM_LIMIT=2G
DB_MEM_RES=1G
DB_CPUS_LIMIT=1
DB_CPUS_RES=1
DB_SHARED_BUFFERS=512MB         # Postgres requires MB/GB, not M/G
DB_EFFECTIVE_CACHE_SIZE=1GB
DB_WORK_MEM=8MB
DB_MAINT_WORK_MEM=128MB
DB_MAX_CONNECTIONS=60           # must stay >= APP_FPM_MAX_CHILDREN + a few spare
DB_MAX_WAL_SIZE=1GB
DB_MIN_WAL_SIZE=512MB
REDIS_MEM_LIMIT=512M
REDIS_MEM_RES=256M
REDIS_CPUS_LIMIT=1
REDIS_CPUS_RES=0.5
REDIS_MAXMEMORY=512mb           # keep below REDIS_MEM_LIMIT

# --- Preset B: STANDARD host (32-64 GB RAM, up to ~400 users, optionally
# multiple app replicas). To use it, comment out Preset A block above and
# uncomment this one:
# APP_REPLICAS=2
# APP_MEM_LIMIT=8G
# APP_MEM_RES=2G
# APP_CPUS_LIMIT=4
# APP_CPUS_RES=1
# APP_FPM_MAX_CHILDREN=           # leave empty to derive from APP_MEM_LIMIT
# APP_FPM_START_SERVERS=
# APP_FPM_MIN_SPARE=
# APP_FPM_MAX_SPARE=
# NGINX_MEM_LIMIT=512M
# NGINX_MEM_RES=256M
# NGINX_CPUS_LIMIT=2
# NGINX_CPUS_RES=1
# CRON_MEM_LIMIT=2G
# CRON_MEM_RES=1G
# SIGNALING_MEM_LIMIT=1G
# SIGNALING_MEM_RES=512M
# TURN_MEM_LIMIT=512M
# TURN_MEM_RES=256M
# CADDY_MEM_LIMIT=512M
# CADDY_MEM_RES=256M
# UPLOAD_MAX_SIZE=10G
# DB_MEM_LIMIT=4G
# DB_MEM_RES=2G
# DB_SHARED_BUFFERS=1GB
# DB_EFFECTIVE_CACHE_SIZE=3GB
# DB_WORK_MEM=16MB
# DB_MAINT_WORK_MEM=512MB
# DB_MAX_CONNECTIONS=150
# DB_MAX_WAL_SIZE=2GB
# DB_MIN_WAL_SIZE=1GB
# REDIS_MEM_LIMIT=1G
# REDIS_MEM_RES=512M
# REDIS_MAXMEMORY=1gb
